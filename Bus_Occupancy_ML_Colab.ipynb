  {
   "cell_type": "markdown",
   "id": "9227085c",
   "metadata": {},
   "source": [
    "## 1. Import libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7bef5f25",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.preprocessing import OneHotEncoder\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import accuracy_score, classification_report, confusion_matrix, ConfusionMatrixDisplay\n",
    "import joblib\n",
    "from pathlib import Path\n",
    "\n",
    "RANDOM_SEED = 42\n",
    "np.random.seed(RANDOM_SEED)\n",
    "Path(\"data\").mkdir(exist_ok=True)\n",
    "Path(\"models\").mkdir(exist_ok=True)\n",
    "Path(\"outputs\").mkdir(exist_ok=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "20687ac1",
   "metadata": {},
   "source": [
    "## 2. Create the synthetic dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a0980f68",
   "metadata": {},
   "outputs": [],
   "source": [
    "rng = np.random.default_rng(RANDOM_SEED)\n",
    "n = 2500\n",
    "capacity = rng.choice([40, 45, 50, 55, 60], size=n)\n",
    "hour = rng.integers(5, 24, size=n)\n",
    "day_type = rng.choice([\"Weekday\", \"Weekend\"], size=n, p=[0.72, 0.28])\n",
    "peak = (((hour >= 7) & (hour <= 10)) | ((hour >= 16) & (hour <= 20))).astype(int)\n",
    "ratio = np.clip(rng.beta(2.2, 2.0, size=n) + peak*0.15\n",
    "                + np.where(day_type == \"Weekend\", -0.08, 0)\n",
    "                + rng.normal(0, 0.08, n), 0.02, 1.25)\n",
    "passengers = np.clip(np.round(ratio * capacity), 0, capacity + 10).astype(int)\n",
    "thermal_signal = np.clip(passengers * 0.85 + rng.normal(0, 3.0, n), 0, None).round(2)\n",
    "prev_ratio = np.clip(ratio + rng.normal(0, 0.12, n), 0, 1.25)\n",
    "previous = np.clip(np.round(prev_ratio * capacity), 0, capacity + 10).astype(int)\n",
    "next_count = np.clip(np.round(passengers + rng.normal(0, 5, n) + np.where(peak == 1, 2, -1)),\n",
    "                     0, capacity + 10).astype(int)\n",
    "occupancy_ratio = passengers / capacity\n",
    "status = np.where(occupancy_ratio < 0.35, \"Empty\",\n",
    "         np.where(occupancy_ratio < 0.75, \"Moderate\", \"Full\"))\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    \"bus_id\": [f\"BUS-{i%25+1:02d}\" for i in range(n)],\n",
    "    \"route_id\": [f\"ROUTE-{i%12+1:02d}\" for i in range(n)],\n",
    "    \"passenger_count\": passengers,\n",
    "    \"bus_capacity\": capacity,\n",
    "    \"hour\": hour,\n",
    "    \"day_type\": day_type,\n",
    "    \"previous_passenger_count\": previous,\n",
    "    \"thermal_signal\": thermal_signal,\n",
    "    \"occupancy_ratio\": occupancy_ratio.round(3),\n",
    "    \"next_stop_passenger_count\": next_count,\n",
    "    \"occupancy_status\": status\n",
    "})\n",
    "df.to_csv(\"data/bus_occupancy_synthetic.csv\", index=False)\n",
    "print(\"Dataset shape:\", df.shape)\n",
    "display(df.head(10))\n",
    "print(\"\\nClass distribution:\")\n",
    "display(df[\"occupancy_status\"].value_counts().rename_axis(\"status\").to_frame(\"records\"))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4bfcae77",
   "metadata": {},
   "source": [
    "## 3. Understand the data\n",
    "`occupancy_status` is the label. For this demo, labels are generated from passenger count / bus capacity:\n",
    "- **Empty:** below 35%\n",
    "- **Moderate:** 35% to below 75%\n",
    "- **Full:** 75% or above\n",
    "\n",
    "`thermal_signal` and all records are simulated. Replace them with properly collected and validated sensor data for real deployment."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3a3dc884",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(7, 4))\n",
    "df[\"occupancy_status\"].value_counts().reindex([\"Empty\", \"Moderate\", \"Full\"]).plot(kind=\"bar\")\n",
    "plt.title(\"Synthetic Bus Occupancy Classes\")\n",
    "plt.xlabel(\"Occupancy status\")\n",
    "plt.ylabel(\"Number of records\")\n",
    "plt.xticks(rotation=0)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "368491cb",
   "metadata": {},
   "source": [
    "## 4. Train and compare Decision Tree and Random Forest"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1fa6bf3a",
   "metadata": {},
   "outputs": [],
   "source": [
    "FEATURES = [\"passenger_count\", \"bus_capacity\", \"hour\", \"day_type\",\n",
    "            \"previous_passenger_count\", \"thermal_signal\"]\n",
    "TARGET = \"occupancy_status\"\n",
    "\n",
    "X = df[FEATURES]\n",
    "y = df[TARGET]\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.2, random_state=RANDOM_SEED, stratify=y\n",
    ")\n",
    "\n",
    "def make_preprocessor():\n",
    "    return ColumnTransformer(\n",
    "        [(\"day_type\", OneHotEncoder(handle_unknown=\"ignore\"), [\"day_type\"])],\n",
    "        remainder=\"passthrough\"\n",
    "    )\n",
    "\n",
    "models = {\n",
    "    \"Decision Tree\": DecisionTreeClassifier(max_depth=6, random_state=RANDOM_SEED),\n",
    "    \"Random Forest\": RandomForestClassifier(n_estimators=150, max_depth=10,\n",
    "                                            random_state=RANDOM_SEED, class_weight=\"balanced\")\n",
    "}\n",
    "trained_models = {}\n",
    "results = {}\n",
    "for name, classifier in models.items():\n",
    "    pipeline = Pipeline([(\"preprocess\", make_preprocessor()), (\"model\", classifier)])\n",
    "    pipeline.fit(X_train, y_train)\n",
    "    predictions = pipeline.predict(X_test)\n",
    "    trained_models[name] = pipeline\n",
    "    results[name] = accuracy_score(y_test, predictions)\n",
    "    print(f\"\\n{name} accuracy: {results[name]:.3f}\")\n",
    "    print(classification_report(y_test, predictions, zero_division=0))\n",
    "    ConfusionMatrixDisplay.from_predictions(\n",
    "        y_test, predictions, labels=[\"Empty\", \"Moderate\", \"Full\"],\n",
    "        display_labels=[\"Empty\", \"Moderate\", \"Full\"], cmap=\"Blues\"\n",
    "    )\n",
    "    plt.title(f\"{name} — Confusion Matrix\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "pd.DataFrame({\"Model\": list(results.keys()), \"Accuracy\": list(results.values())})"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "70458ae4",
   "metadata": {},
   "source": [
    "## 5. Save the trained models and dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fbceba1c",
   "metadata": {},
   "outputs": [],
   "source": [
    "joblib.dump(trained_models[\"Decision Tree\"], \"models/decision_tree.joblib\")\n",
    "joblib.dump(trained_models[\"Random Forest\"], \"models/random_forest.joblib\")\n",
    "df.to_csv(\"data/bus_occupancy_synthetic.csv\", index=False)\n",
    "print(\"Saved dataset and models.\")\n",
    "print(\"Dataset: data/bus_occupancy_synthetic.csv\")\n",
    "print(\"Models: models/decision_tree.joblib and models/random_forest.joblib\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ab6e1a82",
   "metadata": {},
   "source": [
    "## 6. Simulate a live bus prediction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8c693cfb",
   "metadata": {},
   "outputs": [],
   "source": [
    "sample_bus = pd.DataFrame([{\n",
    "    \"passenger_count\": 42,\n",
    "    \"bus_capacity\": 50,\n",
    "    \"hour\": 8,\n",
    "    \"day_type\": \"Weekday\",\n",
    "    \"previous_passenger_count\": 35,\n",
    "    \"thermal_signal\": 36.5\n",
    "}])\n",
    "\n",
    "chosen_model = trained_models[\"Random Forest\"]\n",
    "predicted_status = chosen_model.predict(sample_bus)[0]\n",
    "occupancy_percent = sample_bus.loc[0, \"passenger_count\"] / sample_bus.loc[0, \"bus_capacity\"] * 100\n",
    "\n",
    "print(\"Bus ID: BUS-DEMO-01\")\n",
    "print(\"Route: ROUTE-DEMO-01\")\n",
    "print(f\"Passengers: {sample_bus.loc[0, 'passenger_count']} / {sample_bus.loc[0, 'bus_capacity']}\")\n",
    "print(f\"Calculated occupancy: {occupancy_percent:.1f}%\")\n",
    "print(\"ML-predicted status:\", predicted_status)\n",
    "print(\"\\nNote: This is one simulated prediction, not a live bus feed.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6f82c52e",
   "metadata": {},
